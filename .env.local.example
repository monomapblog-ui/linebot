# Anthropic Claude API
ANTHROPIC_API_KEY=

# LINE Developers コンソールで発行されるチャネル情報
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ローカル開発用: trueにすると、実際のLINE Reply APIを呼ばずに
# 生成した返信内容をコンソールに出力するだけになる
LINE_MOCK_MODE=false

# scripts/mock-line-event.ts が投げつけるWebhookエンドポイント（省略時はlocalhost:3000）
WEBHOOK_URL=http://localhost:3000/api/line/webhook
